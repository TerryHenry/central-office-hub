{
  "enabled": true,
  "mode": "vip",
  "role": "primary",
  "peerHost": "10.0.0.6",
  "listenPort": 8555,
  "peerPort": 8555,
  "vip": {
    "address": "10.0.0.10",
    "prefix": 24,
    "interface": "eth0"
  },
  "dns": {
    "updateCommand": ""
  },
  "healthCheck": {
    "intervalMs": 3000,
    "failureThreshold": 3,
    "timeoutMs": 2000
  },
  "replication": {
    "intervalMs": 5000,
    "remoteDataDir": "/opt/central-office/data",
    "sshUser": "central-office",
    "sshKeyPath": "/opt/central-office/ha-agent/replication-key"
  },
  "preemptOnRecovery": false
}
