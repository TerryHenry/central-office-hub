[Unit]
Description=Central Office HA Agent (failover health-check, replication, promotion)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/central-office
ExecStart=/usr/bin/node /opt/central-office/ha-agent.js
Restart=on-failure
RestartSec=3
Environment=HA_AGENT_DIR=/opt/central-office/ha-agent
User=central-office-ha
Group=central-office-ha
# Needed to read/write the main app's data directory during an rsync pull -- that
# directory is owned by the central-office account, not this one. Applied at the
# process level by systemd regardless of /etc/group membership.
SupplementaryGroups=central-office
# Lets this agent add/remove the HA virtual IP and send gratuitous ARP on
# promotion/demotion without running as root. Starting/stopping the main app's own
# service is a *separate* privilege, granted the way this whole project grants itself
# privileged actions elsewhere: a narrow sudoers rule limited to one fixed helper script
# (provisioning/ha-service-helper.sh, installed by ha-setup.sh) -- Linux capabilities
# don't cover systemd unit control, so a capability alone can't substitute for that here.
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW

[Install]
WantedBy=multi-user.target
